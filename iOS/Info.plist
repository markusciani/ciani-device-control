<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Ciani Device Control</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ciani-control._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ciani Device Control discovers and manages paired Apple TVs on your local network.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Ciani Device Control uses Apple Configurator to start and stop Single App Mode on supervised Apple TVs.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to securely unlock the Ciani Device Control administrator console.</string>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
